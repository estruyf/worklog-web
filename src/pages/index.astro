</Layout>

<style>
  .page {
    --ink: #1f2328;
    --muted: #57606a;
    --faint: #8b949e;
    --border: #e5e7eb;
    --border-strong: #d0d7de;
    --surface: #f6f8fa;
    --brand: #f4cf4d;
    --brand-strong: #e2be2e;
    --brand-tint: #fbefc0;

    color: var(--ink);
    background:
      radial-gradient(
        60% 55% at 78% -8%,
        rgba(244, 207, 77, 0.22),
        transparent 60%
      ),
      radial-gradient(
        48% 40% at -6% 4%,
        rgba(244, 207, 77, 0.12),
        transparent 62%
      ),
      linear-gradient(180deg, #fff, #fbfcfd 40%, #f6f8fa);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---- Nav ---- */
  .nav {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 17px;
    color: var(--ink);
    text-decoration: none;
  }
  .nav-cta {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    padding: 8px 16px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: #fff;
    transition:
      border-color 0.15s,
      background 0.15s;
  }
  .nav-cta:hover {
    border-color: var(--brand-strong);
    background: var(--brand-tint);
  }

  /* ---- Hero ---- */
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
    padding: 56px 0 72px;
  }
  .eyebrow {
    display: inline-block;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-strong);
    background: var(--brand-tint);
    padding: 5px 11px;
    border-radius: 999px;
    margin-bottom: 18px;
  }
  .hero h1 {
    margin: 0 0 18px;
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 800;
  }
  .lede {
    margin: 0 0 28px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--muted);
    max-width: 34em;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .fine {
    color: var(--faint);
    font-size: 12.5px;
    margin: 18px 0 0;
  }
  code {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1px 6px;
    border-radius: 5px;
    font-size: 0.92em;
  }

  /* ---- Buttons ---- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    padding: 11px 20px;
    border-radius: 10px;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s,
      transform 0.1s,
      box-shadow 0.15s;
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn-primary {
    background: #1f2328;
    color: #fff;
    box-shadow: 0 1px 2px rgba(31, 35, 40, 0.2);
  }
  .btn-primary:hover {
    background: #000;
  }
  .btn-ghost {
    background: #fff;
    color: var(--ink);
    border-color: var(--border-strong);
  }
  .btn-ghost:hover {
    border-color: var(--brand-strong);
    background: var(--brand-tint);
  }
  .btn-lg {
    padding: 13px 24px;
    font-size: 16px;
  }

  /* ---- Hero visual (mock) ---- */
  .hero-visual {
    display: flex;
    justify-content: center;
  }
  .mock {
    width: 100%;
    max-width: 420px;
    background: #fff;
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    box-shadow:
      0 24px 60px rgba(31, 35, 40, 0.12),
      0 2px 6px rgba(31, 35, 40, 0.05);
    overflow: hidden;
    transform: rotate(1.2deg);
  }
  .mock-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .mock-bar .dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #d0d7de;
  }
  .mock-title {
    margin-left: 8px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--muted);
  }
  .mock-body {
    padding: 18px;
  }
  .mock-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 16px;
  }
  .stat {
    background: var(--surface);
    border-radius: 10px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stat-label {
    font-size: 11px;
    color: var(--muted);
  }
  .stat-value {
    font-size: 22px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .mock-chart {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    height: 96px;
    padding: 0 2px 4px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }
  .mock-chart span {
    flex: 1;
    background: linear-gradient(180deg, var(--brand), var(--brand-strong));
    border-radius: 5px 5px 0 0;
    min-height: 6px;
  }
  .mock-rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mock-rows .row {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    color: var(--ink);
  }
  .mock-rows .swatch {
    width: 9px;
    height: 9px;
    border-radius: 999px;
  }
  .row-num {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    font-weight: 600;
  }

  /* ---- Features ---- */
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(248px, 1fr));
    gap: 16px;
    padding: 8px 0 24px;
  }
  .feature {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
    transition:
      border-color 0.15s,
      box-shadow 0.15s,
      transform 0.15s;
  }
  .feature:hover {
    border-color: var(--border-strong);
    box-shadow: 0 8px 24px rgba(31, 35, 40, 0.06);
    transform: translateY(-2px);
  }
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--brand-tint);
    color: #8a6d09;
    margin-bottom: 14px;
  }
  .feature h3 {
    margin: 0 0 7px;
    font-size: 16.5px;
    font-weight: 700;
  }
  .feature p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---- See it in action ---- */
  .demo {
    padding: 56px 0 8px;
  }
  /* The video is dark and the page is not, so it gets the brand ring and a
     shadow rather than the hairline border the light cards use — against a white
     page a 1px grey line around a black rectangle reads as a rendering artefact. */
  .demo-player {
    border-radius: 14px;
    overflow: hidden;
    background: #101319;
    border: 1px solid var(--border-strong);
    box-shadow:
      0 24px 60px rgba(31, 35, 40, 0.18),
      0 2px 8px rgba(31, 35, 40, 0.08);
  }
  .demo-player video {
    display: block;
    width: 100%;
    height: auto;
    /* The poster and the video share 16:9, so the box is the right height before
       either has loaded and the page below never jumps. */
    aspect-ratio: 16 / 9;
  }
  .demo-note {
    margin: 14px 0 0;
    text-align: center;
    font-size: 14.5px;
    color: var(--muted);
  }
  .demo-note a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--brand-strong);
    text-underline-offset: 3px;
  }

  /* ---- How it works ---- */
  .how {
    padding: 64px 0 40px;
  }
  .how-head {
    text-align: center;
    margin-bottom: 40px;
  }
  .how-head h2 {
    margin: 4px 0 0;
    font-size: clamp(26px, 3.5vw, 34px);
    letter-spacing: -0.02em;
    font-weight: 800;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .step-n {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--brand);
    color: #3a2e05;
    font-weight: 800;
    font-size: 15px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .step h3 {
    margin: 4px 0 6px;
    font-size: 16px;
    font-weight: 700;
  }
  .step p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---- Under the hood ---- */
  .internals {
    padding: 40px 0 24px;
  }
  .section-sub {
    max-width: 42em;
    margin: 14px auto 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }
  .internals-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    align-items: start;
  }
  .tree-card,
  .config-card,
  .notes-card,
  .lists-card {
    grid-column: 1 / -1;
  }
  .code-card {
    background: #1f2328;
    border: 1px solid #2b3138;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 14px 40px rgba(31, 35, 40, 0.16);
  }
  .code-head {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px 16px;
    border-bottom: 1px solid #2b3138;
  }
  .code-head::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--brand);
    flex: none;
  }
  .code-head .fname {
    font-family: var(--font-jetbrains-mono), ui-monospace, monospace;
    font-size: 12.5px;
    color: #adbac7;
  }
  .code {
    margin: 0;
    padding: 16px 18px;
    font-family: var(--font-jetbrains-mono), ui-monospace, monospace;
    font-size: 13px;
    line-height: 1.7;
    color: #e6edf3;
    overflow-x: auto;
    white-space: pre;
    tab-size: 2;
  }
  .code :global(.cmt) {
    color: #7d8590;
  }
  .code-foot {
    padding: 11px 18px;
    border-top: 1px solid #2b3138;
    font-size: 12.5px;
    line-height: 1.55;
    color: #9aa4af;
  }
  .code-foot code {
    background: rgba(255, 255, 255, 0.07);
    border: none;
    color: #d7c98a;
    padding: 1px 5px;
  }
  .commit-note,
  .capture-note {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-top: 16px;
    padding: 20px 22px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  .commit-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--brand-tint);
    color: #8a6d09;
  }
  .commit-note p,
  .capture-note p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--muted);
  }
  .commit-note strong,
  .capture-note strong {
    color: var(--ink);
    font-weight: 600;
  }
  /* The steps grid centres itself under 860px; keep this readable beside it. */
  .capture-note {
    margin-top: 28px;
  }

  /* ---- FAQ ---- */
  .faq {
    padding: 56px 0 24px;
  }
  .faq-list {
    max-width: 100%;
    margin: 36px auto 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0 20px;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .faq-item[open] {
    border-color: var(--border-strong);
    box-shadow: 0 8px 24px rgba(31, 35, 40, 0.05);
  }
  .faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary code {
    font-weight: 600;
  }
  .chev {
    flex: none;
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--faint);
    border-bottom: 2px solid var(--faint);
    transform: rotate(45deg);
    transition: transform 0.2s;
    margin-right: 3px;
  }
  .faq-item[open] .chev {
    transform: rotate(-135deg);
  }
  .faq-a {
    padding: 0 0 18px;
  }
  .faq-a p {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
  }
  .faq-a a {
    color: #b5891a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ---- CTA ---- */
  .cta {
    padding: 40px 0 72px;
  }
  .cta-inner {
    text-align: center;
    background: linear-gradient(180deg, #fffdf3, #fdf6da);
    border: 1px solid var(--brand-tint);
    border-radius: 20px;
    padding: 48px 32px;
    box-shadow: 0 12px 40px rgba(226, 190, 46, 0.12);
  }
  .cta-inner h2 {
    margin: 14px 0 8px;
    font-size: clamp(24px, 3.5vw, 32px);
    letter-spacing: -0.02em;
    font-weight: 800;
  }
  .cta-inner p {
    margin: 0 auto 24px;
    max-width: 40em;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
  }
  .cta-note {
    margin: 18px auto 0 !important;
    font-size: 13px !important;
    color: var(--faint) !important;
  }

  /* ---- Footer ---- */
  .foot {
    border-top: 1px solid var(--border);
    padding: 28px 24px;
    max-width: 1080px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .foot-top {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    justify-content: space-between;
  }
  .foot-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 14px;
  }
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
  .foot-links a {
    font-size: 13.5px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .foot-links a:hover {
    color: var(--brand-strong);
  }
  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    align-items: center;
    justify-content: space-between;
  }
  .foot-note {
    font-size: 13px;
    color: var(--faint);
  }
  .foot-badge {
