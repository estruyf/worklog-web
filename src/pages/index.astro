---
import Layout from "../layouts/Layout.astro";
import { CHANGELOG_PATH, CHROME_EXTENSION_URL, ISSUES_URL } from "../model/links";

export const prerender = false;

const features = [
  {
    title: "Day view",
    body: "Your day as one proportional bar — every entry sized against your working day, and whatever is left over is an Unlogged slot you click to fill.",
    icon: "day",
  },
  {
    title: "Day notes",
    body: "The half of a day that isn’t billed and isn’t a task: what was said, what was decided, what you want to remember on Monday.",
    icon: "note",
  },
  {
    title: "Overdue",
    body: "Everything that has slipped, across every client, grouped with the longest-overdue first — plus a count badge so nothing quietly rots.",
    icon: "alert",
  },
  {
    title: "Upcoming",
    body: "Everything still ahead, bucketed by how far off it is — tomorrow, later this week, next week, later this month — so a deadline three weeks out stops being a surprise.",
    icon: "clock",
  },
  {
    title: "Calendar",
    body: "A month grid of who you worked for each day, with per-client rollups. Click any day to jump straight into it.",
    icon: "calendar",
  },
  {
    title: "Clients & tasks",
    body: "Group work by client — with tags, due dates, subtasks, links and full Markdown descriptions — or drop it in the general to-do bucket that belongs to no client.",
    icon: "layers",
  },
  {
    title: "Recurring tasks",
    body: "“Monthly on last”, “weekly on mon,thu”, “every 3 days”. Tick one off and the next occurrence is computed on the spot — nothing runs in the background.",
    icon: "repeat",
  },
  {
    title: "Lists",
    body: "Reusable checklists — a packing list, a release run, the invoicing routine. Tick through it, drag items into order, press Start again and it is waiting unticked for next time.",
    icon: "list",
  },
  {
    title: "Search everything",
    body: "One shortcut over open tasks, the archive and your day notes. Filter by tag, and every tag chip in the app is a filter you can click.",
    icon: "search",
  },
  {
    title: "Insights",
    body: "Monthly hours and days per client, an events breakdown, an hours-by-client chart and a trend line — turned into charts, never a spreadsheet.",
    icon: "chart",
  },
  {
    title: "Archive",
    body: "Closed tasks roll into a searchable archive you can filter by period, so your active lists stay clean.",
    icon: "archive",
  },
];

const steps = [
  {
    n: "1",
    title: "Sign in with GitHub",
    body: "One click. Your token stays server-side in an httpOnly cookie — never in the browser.",
  },
  {
    n: "2",
    title: "Pick or create a repo",
    body: "Choose an existing repository or spin up a fresh one. Worklog initializes the folders it needs on first use.",
  },
  {
    n: "3",
    title: "Track your work",
    body: "Log hours, manage tasks and watch your insights build — all saved as Markdown you can read anywhere.",
  },
];

// Faithful examples of the on-repo format for the "Under the hood" section.
// `t` is the tree line, `c` is an inline comment.
const tree = [
  { t: "your-repo/" },
  { t: "├── .worklog/" },
  {
    t: "│   └── config.json",
    c: "hours/day · week start · clients · statuses · sync",
  },
  { t: "├── clients/" },
  { t: "│   ├── acme.md", c: "one file per client · its open tasks" },
  { t: "│   └── todos.md", c: "general, non-client to-dos" },
  { t: "├── worklog/" },
  { t: "│   └── 2026-06.md", c: "one file per month · logged hours" },
  { t: "├── notes/" },
  { t: "│   └── 2026-06.md", c: "one block per day · freeform notes" },
  { t: "├── archive/" },
  { t: "│   └── acme/2026-06.md", c: "closed tasks · per client, per month" },
  { t: "├── lists/" },
  { t: "│   └── release.md", c: "one file per reusable checklist" },
  { t: "└── assets/", c: "images pasted into descriptions" },
];

const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const treeHtml = tree
  .map((l) => {
    const line = esc(l.t.padEnd(24));
    return l.c ? `${line}<span class="cmt"># ${esc(l.c)}</span>` : line;
  })
  .join("\n");

const configJson = `{
  "hoursPerDay": 8,
  "weekStart": 1,
  "clients": [
    { "id": "acme", "name": "Acme Corp", "color": "#3366ff" }
  ],
  "statuses": [
    { "id": "open", "label": "Open" },
    { "id": "done", "label": "Closed", "terminal": true }
  ],
  "autoSync": {
    "enabled": true,
    "delayMinutes": 5,
    "events": ["timeLogged", "dayNote"]
  }
}`;

const worklogMd = `# Worklog 2026-06

- 2026-06-25 acme 4 — social feed
- 2026-06-25 globex 3.5
- 2026-06-26 acme 8
- 2026-06-27 event:vacation 8`;

const clientMd = `# Acme Corp

## Build the onboarding flow
- id: t_a1b2c3
- status: in-progress
- due: 2026-06-30
- worked: 2026-06-21
- tags: frontend, priority

Freeform Markdown description — images and all.

## Send the monthly invoice reminder
- id: t_rc3ccc
- status: open
- due: 2026-06-30
- repeat: monthly on last`;

const notesMd = `# Notes 2026-06

## 2026-06-25

Kickoff with Globex. They want the uploader before the demo.

- chase the SSO ticket

## 2026-06-26

Export queue prototype. Renders, doesn't paginate yet.`;

const listMd = `# Release checklist
- last run: 2026-06-12

Run this from a clean checkout of \`main\`.

## Steps
- [ ] Bump the version
- [x] Update the changelog
- [ ] Tag it

## After
- [ ] Announce it`;
---

<Layout
  title="Worklog — a GitHub-backed timesheet"
  description="Track clients, tasks and hours as plain Markdown in a GitHub repo you own. No database, no lock-in — Worklog just reads, writes and commits your timesheet for you."
  noindex={false}
>
  <div class="page">
    <header class="nav">
      <a class="brand" href="/">
        <img src="/worklog-logo-outline.svg" alt="" width="32" height="32" />
        <span>Worklog</span>
      </a>
      <a class="nav-cta" href="/api/auth/login">Sign in</a>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <span class="eyebrow">Your timesheet, in your own repo</span>
          <h1>Track your time where your code already lives.</h1>
          <p class="lede">
            Worklog is a GitHub-backed timesheet. Clients, tasks and hours are
            stored as Markdown in a repository you own — this app just reads and
            writes them, and commits every change back for you.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/api/auth/login">
              <svg
                width="18"
                height="18"
                viewBox="0 0 16 16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
                ></path>
              </svg>
              Sign in with GitHub
            </a>
            <a class="btn btn-ghost" href="#how">See how it works</a>
          </div>
          <p class="fine">
            Requests the <code>repo</code> scope so it can read and commit to your
            timesheet repository.
          </p>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="mock">
            <div class="mock-bar">
              <span class="dot"></span><span class="dot"></span><span
                class="dot"></span>
              <span class="mock-title">Insights · July</span>
            </div>
            <div class="mock-body">
              <div class="mock-stats">
                <div class="stat">
                  <span class="stat-label">Clients</span><span
                    class="stat-value">4</span
                  >
                </div>
                <div class="stat">
                  <span class="stat-label">Hours</span><span class="stat-value"
                    >132</span
                  >
                </div>
                <div class="stat">
                  <span class="stat-label">Days</span><span class="stat-value"
                    >16.5</span
                  >
                </div>
              </div>
              <div class="mock-chart">
                <span style="height: 42%"></span>
                <span style="height: 70%"></span>
                <span style="height: 55%"></span>
                <span style="height: 88%"></span>
                <span style="height: 34%"></span>
                <span style="height: 62%"></span>
              </div>
              <div class="mock-rows">
                <div class="row">
                  <span class="swatch" style="background:#4C8BF5"></span>Acme
                  Corp<span class="row-num">48</span>
                </div>
                <div class="row">
                  <span class="swatch" style="background:#16A34A"
                  ></span>Northwind<span class="row-num">36</span>
                </div>
                <div class="row">
                  <span class="swatch" style="background:#E2BE2E"
                  ></span>Internal<span class="row-num">28</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* The two cuts from promo/. `preload="none"` and a poster mean the page
          costs one 120 KB image until someone presses play — the hero is the
          thing that has to load fast, and this sits directly under it. Both are
          silent by design, so there are no controls for a volume that does not
          exist beyond the browser's own. */}
      <section class="demo" id="demo">
        <div class="how-head">
          <span class="eyebrow">See it in action</span>
          <h2>Thirty seconds, start to commit.</h2>
        </div>
        <div class="demo-player">
          <video
            controls
            playsinline
            preload="none"
            poster="/video/worklog-poster.jpg"
            width="1920"
            height="1080"
          >
            <source src="/video/worklog-promo.mp4" type="video/mp4" />
          </video>
        </div>
        <p class="demo-note">
          Recorded against a demo timesheet — every screen is the real app. Want
          the long version?{' '}
          <a href="/video/worklog-tour.mp4">The 90-second tour</a> walks through every
          view, from the day bar to the commit it writes.
        </p>
      </section>

      <section class="features">
        {
          features.map((f) => (
            <article class="feature">
              <span class="feature-icon">
                {f.icon === "day" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <path d="M16 2v4" />
                    <path d="M8 2v4" />
                    <path d="M3 10h18" />
                    <path d="M8 15h5" />
                  </svg>
                )}
                {f.icon === "calendar" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <path d="M16 2v4" />
                    <path d="M8 2v4" />
                    <path d="M3 10h18" />
                    <path d="M7 14h.01" />
                    <path d="M12 14h.01" />
                    <path d="M17 14h.01" />
                    <path d="M7 18h.01" />
                    <path d="M12 18h.01" />
                  </svg>
                )}
                {f.icon === "clock" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h6" />
                    <path d="M3 10h13" />
                    <path d="M16 2v4" />
                    <path d="M8 2v4" />
                    <circle cx="17.5" cy="17.5" r="4.5" />
                    <path d="M17.5 15.5v2.2l1.4 1" />
                  </svg>
                )}
                {f.icon === "layers" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m12 2 9 5-9 5-9-5 9-5Z" />
                    <path d="m3 12 9 5 9-5" />
                    <path d="m3 17 9 5 9-5" />
                  </svg>
                )}
                {f.icon === "note" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" />
                    <path d="M14 3v6h6" />
                    <path d="M8 13h6" />
                    <path d="M8 17h4" />
                  </svg>
                )}
                {f.icon === "alert" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                  </svg>
                )}
                {f.icon === "repeat" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m17 2 4 4-4 4" />
                    <path d="M3 11v-1a4 4 0 0 1 4-4h14" />
                    <path d="m7 22-4-4 4-4" />
                    <path d="M21 13v1a4 4 0 0 1-4 4H3" />
                  </svg>
                )}
                {f.icon === "list" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m3 6 1.5 1.5L7 5" />
                    <path d="m3 12 1.5 1.5L7 11" />
                    <path d="m3 18 1.5 1.5L7 17" />
                    <path d="M11 6h10" />
                    <path d="M11 12h10" />
                    <path d="M11 18h10" />
                  </svg>
                )}
                {f.icon === "search" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-3.5-3.5" />
                  </svg>
                )}
                {f.icon === "chart" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M3 3v18h18" />
                    <rect x="7" y="12" width="3" height="6" />
                    <rect x="13" y="8" width="3" height="10" />
                  </svg>
                )}
                {f.icon === "archive" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="4" width="18" height="4" rx="1" />
                    <path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8" />
                    <path d="M10 12h4" />
                  </svg>
                )}
              </span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </section>

      <section class="how" id="how">
        <div class="how-head">
          <span class="eyebrow">How it works</span>
          <h2>From zero to logging in under a minute.</h2>
        </div>
        <ol class="steps">
          {
            steps.map((s) => (
              <li class="step">
                <span class="step-n">{s.n}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="capture-note">
          <span class="commit-icon" aria-hidden="true">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path>
              <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path>
            </svg>
          </span>
          <p>
            <strong>Capture a task from anywhere.</strong> A bookmarklet, a browser
            extension or any shortcut that can open a URL hands Worklog a task:
            <code>/app/new?title=…&amp;url=…&amp;client=acme</code> opens the new-task
            form pre-filled. It fills the form and nothing else — you review it and
            press Save.
          </p>
        </div>
      </section>

      <section class="internals" id="internals">
        <div class="how-head">
          <span class="eyebrow">Under the hood</span>
          <h2>Plain Markdown, all the way down.</h2>
          <p class="section-sub">
            No proprietary format, no database. Everything Worklog knows lives
            in a handful of human-readable files you can open, grep, diff and
            hand-edit — right inside your repo.
          </p>
        </div>

        <div class="internals-grid">
          <div class="code-card tree-card">
            <div class="code-head">
              <span class="fname">your repository</span>
            </div>
            <pre class="code" set:html={treeHtml} />
          </div>

          <div class="code-card config-card">
            <div class="code-head">
              <span class="fname">.worklog/config.json</span>
            </div>
            <pre class="code">{configJson}</pre>
            <div class="code-foot">
              <code>events</code> lists the change kinds worth pushing straight away
              — the rest coalesce into one commit after <code>delayMinutes</code>.
            </div>
          </div>

          <div class="code-card">
            <div class="code-head">
              <span class="fname">worklog/2026-06.md</span>
            </div>
            <pre class="code">{worklogMd}</pre>
            <div class="code-foot">
              One line per client, per day: <code
                >- date client hours — note</code
              >.
            </div>
          </div>

          <div class="code-card">
            <div class="code-head">
              <span class="fname">clients/acme.md</span>
            </div>
            <pre class="code">{clientMd}</pre>
            <div class="code-foot">
              One <code>## heading</code> block per task; closing it moves the block
              to <code>archive/</code> — or, with a <code>repeat:</code> line, rolls
              it onto the next occurrence.
            </div>
          </div>

          <div class="code-card notes-card">
            <div class="code-head">
              <span class="fname">notes/2026-06.md</span>
            </div>
            <pre class="code">{notesMd}</pre>
            <div class="code-foot">
              One <code>## &lt;date&gt;</code> block per day. A heading is only a day
              when it is <em>nothing but</em> a date, so your own <code>##</code> headings
              stay prose.
            </div>
          </div>

          <div class="code-card lists-card">
            <div class="code-head">
              <span class="fname">lists/release.md</span>
            </div>
            <pre class="code">{listMd}</pre>
            <div class="code-foot">
              Plain GFM checkboxes, grouped by optional <code>## headings</code>.
              Ticking one rewrites that single line; <strong>Start again</strong>
              clears them all and stamps <code>- last run:</code>.
            </div>
          </div>
        </div>

        <div class="commit-note">
          <span class="commit-icon" aria-hidden="true">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="3"></circle><line
                x1="3"
                y1="12"
                x2="9"
                y2="12"></line><line x1="15" y1="12" x2="21" y2="12"></line>
            </svg>
          </span>
          <p>
            Every change is written straight back to your branch through the
            GitHub Git Data API —
            <strong>blobs → tree → commit → ref</strong> — coalesced into a single
            <code>chore: worklog sync &lt;date&gt;</code> commit. No pull requests.
            A sync goes both ways: it pulls whatever was committed elsewhere first,
            and a file that moved on both sides is
            <strong>merged record by record, never line by line</strong> — tasks by
            their <code>id</code>, logged hours by date and client — so a conflict
            marker can never land in Markdown. Your token stays in a server-side
            httpOnly cookie; the browser never calls GitHub directly.
          </p>
        </div>
      </section>

      <section class="faq" id="faq">
        <div class="how-head">
          <span class="eyebrow">FAQ</span>
          <h2>Good questions, answered.</h2>
        </div>
        <div class="faq-list">
          <details class="faq-item">
            <summary
              >Is Worklog free?<span class="chev" aria-hidden="true"
              ></span></summary
            >
            <div class="faq-a">
              <p>
                Yes. You bring your own GitHub repository — there's no separate
                account, no server storing your data, and nothing to pay for.
                The code is on <a href="https://github.com/estruyf/worklog-web"
                  >GitHub</a
                >.
              </p>
            </div>
          </details>
          <details class="faq-item">
            <summary
              ><span>Why does it need the <code>repo</code> scope?</span><span
                class="chev"
                aria-hidden="true"></span></summary
            >
            <div class="faq-a">
              <p>
                So it can read your timesheet and commit your changes back.
                GitHub's OAuth <code>repo</code> scope is granted per token, but Worklog
                only ever touches its own files — <code>.worklog/</code>, <code
                  >clients/</code
                >, <code>worklog/</code>, <code>notes/</code>, <code>archive/</code
                >, <code>lists/</code> and <code>assets/</code> — in the repository
                you choose.
              </p>
            </div>
          </details>
          <details class="faq-item">
            <summary
              >Where is my data stored? Is it private?<span
                class="chev"
                aria-hidden="true"></span></summary
            >
            <div class="faq-a">
              <p>
                In your repository, and nowhere else — Worklog has no database.
                Keep it in a private repo and it stays private. Your GitHub
                token lives in a server-side, httpOnly cookie, so it's never
                exposed to the browser or any third party.
              </p>
            </div>
          </details>
          <details class="faq-item">
            <summary
              >Can I edit the files by hand?<span
                class="chev"
                aria-hidden="true"></span></summary
            >
            <div class="faq-a">
              <p>
                Absolutely. Everything is plain Markdown and JSON (see <a
                  href="#internals">Under the hood</a
                >). Edit in your own editor or right on github.com — Worklog
                reads whatever's there the next time you open it.
              </p>
            </div>
          </details>
          <details class="faq-item">
            <summary
              >Can I install it as an app?<span class="chev" aria-hidden="true"
              ></span></summary
            >
            <div class="faq-a">
              <p>
                Yes — Worklog is a PWA. Add it to your desktop or phone home
                screen for a native, full-screen feel; it caches its shell so it
                loads instantly, and commits your work back to GitHub whenever
                you're online.
              </p>
            </div>
          </details>
          <details class="faq-item">
            <summary
              >Is there a browser extension?<span class="chev" aria-hidden="true"
              ></span></summary
            >
            <div class="faq-a">
              <p>
                Yes — <a href={CHROME_EXTENSION_URL}>Worklog for Chrome</a> adds
                a task to your timesheet straight from a GitHub issue or pull
                request, or from a Productive item, without leaving the page
                you're on. It's optional; everything still lands in the same
                repo.
              </p>
            </div>
          </details>
          <details class="faq-item">
            <summary
              >What happens when I close a task?<span
                class="chev"
                aria-hidden="true"></span></summary
            >
            <div class="faq-a">
              <p>
                It moves out of the client file and into <code
                  >archive/&lt;client&gt;/&lt;month&gt;.md</code
                >, stamped with its completion date. Your active lists stay
                tidy, and nothing is ever lost — reopening a task simply moves
                it back. A recurring task instead rolls onto its next date and
                files a snapshot of the occurrence you just finished.
              </p>
            </div>
          </details>
          <details class="faq-item">
            <summary
              >Can I use it on more than one device?<span
                class="chev"
                aria-hidden="true"></span></summary
            >
            <div class="faq-a">
              <p>
                Yes — the repo is the shared state. Every sync pulls before it
                pushes, an open tab notices a push from elsewhere on its own, and
                anything changed on both sides is merged per task, per logged day
                and per client rather than per line. Edit on your laptop, your
                phone, or on github.com; it all converges.
              </p>
            </div>
          </details>
        </div>
      </section>

      <section class="cta">
        <div class="cta-inner">
          <img src="/worklog-logo-outline.svg" alt="" width="48" height="48" />
          <h2>Own your timesheet.</h2>
          <p>
            No database, no export button, no lock-in — just Markdown in a repo
            you already trust.
          </p>
          <a class="btn btn-primary btn-lg" href="/api/auth/login">
