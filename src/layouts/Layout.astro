---
interface Props {
  title?: string;
}
const { title = 'Worklog' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/worklog-logo-outline.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    font-family: 'Inter', -apple-system, system-ui, 'Segoe UI', sans-serif;
  }
  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    padding: 0;
  }
</style>
