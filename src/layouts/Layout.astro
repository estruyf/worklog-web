---
import { Font } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
  /** Path or URL to the social-share image. Resolved to an absolute URL. */
  image?: string;
  /** When true (default) the page is kept out of search engines. */
  noindex?: boolean;
  ogType?: string;
}
const { title = 'Worklog', description, image, noindex = true, ogType = 'website' } = Astro.props;

// SSR (`output: "server"`) means Astro.url is the live request URL, so we can
// build absolute canonical/social URLs without a hardcoded production domain.
const canonical = new URL(Astro.url.pathname, Astro.url).href;
const ogImage = new URL(image ?? '/worklog-512x512.png', Astro.url).href;

// iOS/Safari doesn't auto-generate PWA splash screens (unlike Android), so we
// point `apple-touch-startup-image` at a pre-rendered image per device. Each
// entry is [cssWidth, cssHeight, devicePixelRatio, pixelWidth, pixelHeight];
// portrait only, matching the manifest's `portrait-primary` orientation.
const iosSplash: [number, number, number, number, number][] = [
  [375, 667, 2, 750, 1334],
  [414, 896, 2, 828, 1792],
  [360, 780, 3, 1080, 2340],
  [375, 812, 3, 1125, 2436],
  [390, 844, 3, 1170, 2532],
  [393, 852, 3, 1179, 2556],
  [402, 874, 3, 1206, 2622],
  [414, 736, 3, 1242, 2208],
  [414, 896, 3, 1242, 2688],
  [428, 926, 3, 1284, 2778],
  [430, 932, 3, 1290, 2796],
  [440, 956, 3, 1320, 2868],
  [768, 1024, 2, 1536, 2048],
  [810, 1080, 2, 1620, 2160],
  [820, 1180, 2, 1640, 2360],
  [834, 1112, 2, 1668, 2224],
  [834, 1194, 2, 1668, 2388],
  [1024, 1366, 2, 2048, 2732],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Worklog" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/worklog-logo-outline.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#F4CF4D" />
    {/* Must be opaque and full-bleed: iOS draws transparent pixels on black and
        then applies its own squircle, so an icon with its own rounded card gets a
        dark frame. Generated from /worklog-icon.svg — see the note in that file. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Worklog" />
    {
      iosSplash.map(([cw, ch, dpr, pw, ph]) => (
        <link
          rel="apple-touch-startup-image"
          media={`screen and (device-width: ${cw}px) and (device-height: ${ch}px) and (-webkit-device-pixel-ratio: ${dpr}) and (orientation: portrait)`}
          href={`/splash/splash-${pw}x${ph}.png`}
        />
      ))
    }
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body>
    <slot />
    {/* Service worker registration and the update handshake. Inline because the
        CSP in src/middleware.ts hashes the inline scripts of the actual response,
        so this needs no policy edit — an external file would.

        The two custom events are the seam to the React island: this script owns
        the registration, src/ui/components/UpdatePrompt.tsx owns the asking. */}
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker
            .register("/sw.js")
            .then((reg) => {
              // Only reload for a handover this page asked for. On a first-ever
              // install `clients.claim()` also fires `controllerchange`, and
              // reloading on that would refresh every first visit for no reason.
              let expectReload = false;
              navigator.serviceWorker.addEventListener("controllerchange", () => {
                if (!expectReload) return;
                expectReload = false;
                location.reload();
              });

              window.addEventListener("worklog:apply-update", () => {
                expectReload = true;
                if (reg.waiting) {
                  reg.waiting.postMessage("SKIP_WAITING");
                } else {
                  // Another tab already took the handover, so there is no worker
                  // left to ask — this tab just needs the new code.
                  location.reload();
                }
              });

              const announce = () => {
                // Nothing to update *from* on a first install: the page was
                // uncontrolled when it loaded and is running current code already.
                if (!navigator.serviceWorker.controller) return;
                // Latched, not just dispatched: a worker can already be waiting
                // the instant this registers, which is well before the React
                // island hydrates. The event alone would fire into an empty room.
                window.__worklogUpdateReady = true;
                window.dispatchEvent(new CustomEvent("worklog:update-ready"));
              };

              if (reg.waiting) announce();
              reg.addEventListener("updatefound", () => {
                const installing = reg.installing;
                if (!installing) return;
                installing.addEventListener("statechange", () => {
                  if (installing.state === "installed") announce();
                });
              });

              // The browser only re-checks on a navigation or roughly daily. An
              // installed PWA can go a week without either, so check whenever it
              // comes back to the foreground — that is the moment someone is
              // about to use it. Throttled because alt-tabbing is not a signal
              // that anything was deployed, and each check is a request.
              let checkedAt = 0;
              document.addEventListener("visibilitychange", () => {
                if (document.visibilityState !== "visible") return;
                const now = Date.now();
                if (now - checkedAt < 60000) return;
                checkedAt = now;
                reg.update().catch(() => {});
              });
            })
            .catch(() => {
              /* registration failures shouldn't break the app */
            });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    font-family: var(--font-inter), -apple-system, system-ui, 'Segoe UI', sans-serif;
  }
  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    padding: 0;
  }
</style>
