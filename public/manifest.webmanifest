{
  "name": "Worklog",
  "short_name": "Worklog",
  "description": "Web-based, GitHub-backed Worklog / timesheet manager. Markdown is the source of truth.",
  "id": "/",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#F4CF4D",
  "protocol_handlers": [
    {
      "protocol": "web+worklog",
      "url": "/app/new?handler=%s"
    }
  ],
  "icons": [
    {
      "src": "/worklog-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/worklog-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/worklog-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Worklog"
    },
    {
      "src": "/screenshots/mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Worklog"
    }
  ],
  "shortcuts": [
    {
      "name": "New task",
      "short_name": "New task",
      "description": "Open the new-task form",
      "url": "/app/new",
      "icons": [{ "src": "/shortcuts/new-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Day",
      "short_name": "Day",
      "description": "Today's tasks and logged time",
      "url": "/app",
      "icons": [{ "src": "/shortcuts/day-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "description": "The month, with what was logged on each day",
      "url": "/app/calendar",
      "icons": [{ "src": "/shortcuts/calendar-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "To-dos",
      "short_name": "To-dos",
      "description": "The general to-do list",
      "url": "/app/todos",
      "icons": [{ "src": "/shortcuts/todos-96x96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
