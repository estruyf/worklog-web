{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/worklog-core/*"],
      "@host/*": ["src/host/*"],
      "@webview/*": ["src/webview/*"]
    }
  },
  "include": ["src", "env.d.ts", ".astro/types.d.ts"],
  "exclude": ["dist", "node_modules"]
}
